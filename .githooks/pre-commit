#!/bin/bash
# Helios Operator Pre-commit Hook
# Ensures code quality before commits

set -e

echo "🔍 Running Helios Operator pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track if any check fails
FAILED=0

# Function to print status
print_status() {
    if [ $1 -eq 0 ]; then
        echo -e "${GREEN}✓${NC} $2"
    else
        echo -e "${RED}✗${NC} $2"
        FAILED=1
    fi
}

# 1. Format Check
echo ""
echo "1️⃣  Checking Go formatting..."
UNFORMATTED=$(gofmt -l .)
if [ -z "$UNFORMATTED" ]; then
    print_status 0 "All files are properly formatted"
else
    echo -e "${YELLOW}The following files need formatting:${NC}"
    echo "$UNFORMATTED"
    echo ""
    echo "Running 'go fmt ./...' to fix..."
    go fmt ./...
    print_status 1 "Files were auto-formatted. Please review and re-add them."
fi

# 2. Go Vet
echo ""
echo "2️⃣  Running go vet..."
if go vet ./... 2>&1; then
    print_status 0 "go vet passed"
else
    print_status 1 "go vet found issues"
fi

# 3. Linting (if golangci-lint is available)
echo ""
echo "3️⃣  Running linter..."
if command -v golangci-lint &> /dev/null; then
    if golangci-lint run --timeout=5m 2>&1; then
        print_status 0 "Linting passed"
    else
        print_status 1 "Linting found issues"
    fi
elif [ -f "bin/golangci-lint" ]; then
    if ./bin/golangci-lint run --timeout=5m 2>&1; then
        print_status 0 "Linting passed"
    else
        print_status 1 "Linting found issues"
    fi
else
    echo -e "${YELLOW}⚠${NC}  golangci-lint not found, skipping..."
fi

# 4. Unit Tests
echo ""
echo "4️⃣  Running unit tests..."
if go test ./... -short -race 2>&1; then
    print_status 0 "Unit tests passed"
else
    print_status 1 "Unit tests failed"
fi

# 5. Generate Manifests (check if up-to-date)
echo ""
echo "5️⃣  Checking if manifests are up-to-date..."
if [ -f "bin/controller-gen" ]; then
    # Save current state
    TMP_DIR=$(mktemp -d)
    cp -r config/crd/bases "$TMP_DIR/"

    # Regenerate
    make manifests > /dev/null 2>&1

    # Compare
    if diff -r config/crd/bases "$TMP_DIR/bases" > /dev/null 2>&1; then
        print_status 0 "Manifests are up-to-date"
    else
        print_status 1 "Manifests are out of date. Run 'make manifests' and commit changes."
    fi

    rm -rf "$TMP_DIR"
else
    echo -e "${YELLOW}⚠${NC}  controller-gen not found, skipping manifest check..."
fi

# 6. Check for common issues
echo ""
echo "6️⃣  Checking for common issues..."

# Check for TODO/FIXME in staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '.go$' || true)
if [ -n "$STAGED_FILES" ]; then
    TODO_COUNT=$(echo "$STAGED_FILES" | xargs grep -n "TODO\|FIXME" 2>/dev/null | wc -l || echo "0")
    if [ "$TODO_COUNT" -gt 0 ]; then
        echo -e "${YELLOW}⚠${NC}  Found $TODO_COUNT TODO/FIXME comments in staged files"
        echo "    (This is just a warning, not blocking commit)"
    fi
fi

# Check for fmt.Println (should use logger)
if [ -n "$STAGED_FILES" ]; then
    PRINTLN_COUNT=$(echo "$STAGED_FILES" | xargs grep -n "fmt.Println" 2>/dev/null | wc -l || echo "0")
    if [ "$PRINTLN_COUNT" -gt 0 ]; then
        echo -e "${YELLOW}⚠${NC}  Found fmt.Println calls (consider using structured logging)"
        echo "$STAGED_FILES" | xargs grep -n "fmt.Println" || true
    fi
fi

print_status 0 "Common issue checks complete"

# Final result
echo ""
echo "================================================"
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
    echo "================================================"
    exit 0
else
    echo -e "${RED}❌ Some pre-commit checks failed!${NC}"
    echo "================================================"
    echo ""
    echo "Please fix the issues above before committing."
    echo "To skip these checks (not recommended), use:"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi
